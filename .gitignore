*.kpf
*.mobi
*.azw
*.azw3


# Python (toolchain)
__pycache__/
*.py[cod]
*.pyo

.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

.venv/
venv/
ENV/
env/

pip-wheel-metadata/
*.egg-info/
.eggs/

# Secrets / env
.env
.env.*
*.key
*.pem

# Misc
*.log

# Prompt
prompt.txt
