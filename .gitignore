# Build outputs (generados)
# se ignora el contenido, pero se mantiene .gitkeep
build/*
!build/.gitkeep

dist/*
!dist/.gitkeep

reports/*
!reports/.gitkeep

# Entregables sueltos (por si alguien genera fuera de dist/)
